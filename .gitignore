# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# macOS / OS metadata
.DS_Store
.AppleDouble
.LSOverride

# IDEs / editors
.vscode/
.idea/
*.swp
*.swo

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Logs / temporary files
*.log
*.tmp
*.bak
tempCodeRunnerFile.py

# Jupyter
.ipynb_checkpoints/

# TensorBoard logs
**/tensorboard/
events.out.tfevents.*

# Generated research outputs (keep source data/results only when intentionally committed)
# Uncomment if you want all generated outputs ignored:
# src/outputs/

# Local datasets that may be downloaded/generated
# Uncomment if datasets should not be committed:
# src/datasets/
